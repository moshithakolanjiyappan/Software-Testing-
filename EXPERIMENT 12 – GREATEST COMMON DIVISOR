import org.junit.jupiter.api.Test;
import static org.junit.jupiter.api.Assertions.*;

class GCDTest {
    int gcd(int a, int b) {
        while (b != 0) {
            int t = b;
            b = a % b;
            a = t;
        }
        return a;
    }

    @Test
    void testGCD() {
        assertEquals(5, gcd(10, 15));
        assertEquals(6, gcd(12, 18));
        assertEquals(1, gcd(7, 9));
        assertEquals(10, gcd(10, 0));
    }
}
