import org.junit.jupiter.api.Test;
import static org.junit.jupiter.api.Assertions.*;

class CompoundInterestTest {
    double calculate(double p, double r, int t) {
        return p * Math.pow(1 + r / 100, t);
    }

    @Test
    void testCompoundInterest() {
        assertEquals(1210, calculate(1000, 10, 2), 0.01);
        assertEquals(1102.5, calculate(1000, 5, 2), 0.01);
        assertEquals(1500, calculate(1000, 50, 1), 0.01);
    }
}
