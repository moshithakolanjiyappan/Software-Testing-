    void testCapacity() {
        int[] users = {100, 200, 300, 400, 500};

        for (int user : users) {
            System.out.println("Concurrent Users: " + user);
            System.out.println("Run the test using JMeter.");
            System.out.println("Record response time and error rate.");
        }

        assertEquals(500, users[4]);
    }
}
