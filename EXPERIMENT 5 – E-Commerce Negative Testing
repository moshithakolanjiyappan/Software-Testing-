import java.util.Scanner;

public class EcommerceNegativeTest {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        System.out.println("E-COMMERCE NEGATIVE TESTING");

        System.out.print("Enter Product Quantity: ");
        int quantity = sc.nextInt();

        if (quantity <= 0) {
            System.out.println("Test Passed: Invalid Quantity Rejected");
        } else {
            System.out.println("Valid Quantity Accepted");
        }

        System.out.print("Enter Payment Option (1 or 2): ");
        int payment = sc.nextInt();

        if (payment != 1 && payment != 2) {
            System.out.println("Test Passed: Invalid Payment Rejected");
        } else {
            System.out.println("Valid Payment Option");
        }

        System.out.print("Enter Discount Code: ");
        sc.nextLine();
        String coupon = sc.nextLine();

        if (!coupon.equals("SAVE10")) {
            System.out.println("Invalid Coupon Code");
        } else {
            System.out.println("Valid Coupon Code");
        }

        sc.close();
    }
}
